# nginx reverse proxy for the Demonic Slots backend.
#
# Put this file at /etc/nginx/sites-available/demonicslots, then:
#
#   sudo ln -s /etc/nginx/sites-available/demonicslots /etc/nginx/sites-enabled/
#   sudo nginx -t
#   sudo systemctl reload nginx
#   sudo certbot --nginx -d demonicslots.thedemonlord333.me
#
# certbot rewrites this file to add the TLS (listen 443/ssl) block and the
# HTTP->HTTPS redirect automatically - the block below is the plain-HTTP
# starting point certbot needs to see before it can issue a certificate.
#
# Before certbot can issue anything, demonicslots.thedemonlord333.me must
# already resolve (an A/AAAA DNS record) to this server's public IP.

server {
    listen 80;
    listen [::]:80;
    server_name demonicslots.thedemonlord333.me;

    location / {
        proxy_pass http://127.0.0.1:3007;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
