[Unit]
Description=Demonic Slots backend (Node.js)
After=network.target

[Service]
Type=simple
WorkingDirectory=/srv/nodeapps/demonicslots/backend
EnvironmentFile=/srv/nodeapps/demonicslots/backend/.env
ExecStart=/usr/bin/node src/server.js
Restart=on-failure
RestartSec=5
User=demonicslots
Group=demonicslots

# Light sandboxing - the service only needs to read its own directory and
# write to its own data/ folder.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/srv/nodeapps/demonicslots/backend/data

[Install]
WantedBy=multi-user.target
