# nginx reverse proxy for the Demonic Slots backend.
#
# Replace YOUR_DOMAIN with your real domain (e.g. api.example.com) and put
# this file at /etc/nginx/sites-available/demonicslots, then:
#
#   sudo ln -s /etc/nginx/sites-available/demonicslots /etc/nginx/sites-enabled/
#   sudo nginx -t
#   sudo systemctl reload nginx
#   sudo certbot --nginx -d YOUR_DOMAIN
#
# certbot rewrites this file to add the TLS (listen 443/ssl) block and the
# HTTP->HTTPS redirect automatically - the block below is the plain-HTTP
# starting point certbot needs to see before it can issue a certificate.

server {
    listen 80;
    listen [::]:80;
    server_name YOUR_DOMAIN;

    location / {
        proxy_pass http://127.0.0.1:3007;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
