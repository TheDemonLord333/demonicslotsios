[Unit]
Description=Demonic Slots backend (Node.js)
After=network.target

[Service]
Type=simple
WorkingDirectory=/srv/nodeapps/demonicslotsios/backend
EnvironmentFile=/srv/nodeapps/demonicslotsios/backend/.env
ExecStart=/usr/bin/node src/server.js
Restart=on-failure
RestartSec=5
User=demonicslots
Group=demonicslots

# Light sandboxing. NoNewPrivileges is a plain prctl() call - safe
# everywhere. PrivateTmp/ProtectSystem=strict/ReadWritePaths need the
# kernel to allow the service a new mount namespace, which some
# virtualized/restricted "root servers" (OpenVZ, certain LXC configs)
# don't permit - that shows up as `systemctl start` failing with
# "Result: resources" no matter what ReadWritePaths points at. If yours
# is one of those hosts, this is deliberately left off; the service
# already only runs as the unprivileged `demonicslots` user, which is
# the security boundary that actually matters here.
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
