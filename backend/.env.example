# Copy this file to .env and fill in real values before starting the server.
# Never commit the real .env file.

# Port the Node process listens on. The iOS app and the nginx reverse proxy
# (see deploy/nginx.conf.example) both assume 3007.
PORT=3007

# Where the SQLite database file lives. The directory is created
# automatically if it doesn't exist.
DB_PATH=./data/demonicslots.sqlite

# Secret bearer token required for every /api/admin/* request (the
# "weitere App" you adjust player balances with). Generate a strong random
# value, e.g.: `openssl rand -hex 32`
ADMIN_TOKEN=change-me-to-a-long-random-secret

# Comma-separated list of origins allowed to call the API from a browser
# (irrelevant for the iOS app itself, only matters if you build a web-based
# admin tool on a different origin than this server). "*" allows any origin.
CORS_ALLOWED_ORIGINS=*
